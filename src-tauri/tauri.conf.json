{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "adwaid-view",
  "version": "0.1.0",
  "identifier": "com.adwaid.view",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "adwaid-view",
        "width": 1100,
        "height": 750,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "license": "PolyForm-Noncommercial-1.0.0",
    "licenseFile": "../LICENSE",
    "targets": [
      "rpm"
    ],
    "linux": {
      "rpm": {
        "files": {
          "/usr/share/licenses/adwaid-view/LICENSE": "../LICENSE",
          "/usr/share/doc/adwaid-view/LICENSE": "../LICENSE"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}